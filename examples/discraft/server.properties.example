# DisCraft server-only configuration: config/discraft/server.properties.
# 專用伺服器首次啟動自動建立功能已開啟、憑證空白的範本；既有新檔或舊設定絕不覆寫。
# Stop the server before editing; keep real credentials private.
# enabled is the only Discord enable switch; no extra JVM flag or environment fallback.
# UTF-8 Java properties. Restart server after editing. No environment fallback.
enabled=true
channel=
botToken=
# Comma-separated authenticated player UUIDs. Empty denies all; * permits all.
allowedPlayers=*
# Discord-side locale: installed mod locale is the base; local packs override per key.
# Missing selected key -> merged en_us -> Forge server en_us / explicit fallback / key.
locale=en_us
# Local ZIP basenames under config/discraft/resourcepacks, low to high priority.
# Resource format 15 (Minecraft 1.20.1), up to 8 packs. Never a URL or absolute path.
resourcePacks=
# Defaults enable all event categories; blank disables automatic notifications.
# Comma-separated: join,quit,death,advancement,lifecycle
notifications=join,quit,death,advancement,lifecycle
# Expand %item / %i from the authoritative main hand; attach a tooltip PNG.
# When configured/enabled, official 1.20.1 vanilla data initializes in the background.
# Verified cache: config/discraft/cache/vanilla/1.20.1; admin ZIPs retain highest priority.
itemDisplay=true
# Mod item tooltips. A DisCraft client may report the tooltip lines it renders
# (mod/client tooltip events included); the server re-renders them in its own style.
#   strict  = accept only if id, count, name and every server-computed line match (default)
#   lenient = accept if id and count match (for mods that rename items or rewrite
#             vanilla lines, e.g. Mine and Slash gear)
#   off     = never use client lines
itemTooltipClient=strict
# Also run the item's own server-side tooltip code (appendHoverText, common tooltip
# events) on a sanitized copy; failing or slow items fall back automatically.
itemTooltipNative=true
# Carry the item's mod NBT (e.g. Mine and Slash gear data) in the in-game chat hover so
# other players' mods can show it. Container contents, book text, stored entities and
# positions are always removed; oversize data falls back to the allowlist. Every DisCraft
# client must run this version or newer when enabled.
itemHoverModData=false

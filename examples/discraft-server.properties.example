# Copy to <dedicated-server>/config/discraft-server.properties; keep that file private.
# UTF-8 Java properties. Restart server after editing. No environment fallback.
enabled=false
channel=
botToken=
# Comma-separated authenticated player UUIDs. Empty denies all; * permits all.
allowedPlayers=
# Discord-side locale. Imported pack -> imported en_us -> common-server en_us -> key.
locale=en_us
# Local ZIP basenames under config/discraft-resourcepacks, low to high priority.
# Resource format 15 (Minecraft 1.20.1), up to 8 packs. Never a URL or absolute path.
resourcePacks=
# Explicit opt-in only; blank sends no automatic event notifications.
# Comma-separated: join,quit,death,advancement,lifecycle
notifications=
# Expand native chat %item from the authoritative main hand. Local model assets required.
itemDisplay=false
